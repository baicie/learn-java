{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "names": {
          "type": "object",
          "properties": {
            "app": {"$ref": "#/definitions/serviceAccountName"},
            "agent": {"$ref": "#/definitions/serviceAccountName"},
            "runner": {"$ref": "#/definitions/serviceAccountName"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"create": {"const": false}}, "required": ["create"]},
          "then": {
            "properties": {"names": {"required": ["app", "agent"]}},
            "required": ["names"]
          }
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceSelector": {"$ref": "#/definitions/nonEmptyLabelSelector"},
        "egress": {
          "type": "object",
          "properties": {
            "dnsNamespaceSelector": {"$ref": "#/definitions/nonEmptyLabelSelector"},
            "allowedCidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,3}|[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4})+/[0-9]{1,3})$"
              }
            },
            "externalPorts": {
              "type": "object",
              "properties": {
                "app": {"$ref": "#/definitions/networkPorts"},
                "agent": {"$ref": "#/definitions/networkPorts"},
                "runner": {"$ref": "#/definitions/networkPorts"}
              },
              "required": ["app", "agent", "runner"],
              "additionalProperties": false
            }
          },
          "required": ["dnsNamespaceSelector", "allowedCidrs", "externalPorts"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "ingressNamespaceSelector", "egress"]
    },
    "security": {
      "type": "object",
      "properties": {
        "diagnosisGrantTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "existingSecrets": {
          "type": "object",
          "properties": {
            "app": {"type": "string"},
            "agent": {"type": "string"},
            "runner": {"type": "string"}
          },
          "required": ["app", "agent", "runner"],
          "additionalProperties": false
        }
      }
    }
  },
  "definitions": {
    "serviceAccountName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "not": {"const": "default"}
    },
    "networkPorts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 65535}
    },
    "nonEmptyLabelSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "operator": {"type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
              "values": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [{"required": ["matchLabels"]}, {"required": ["matchExpressions"]}]
    }
  }
}
