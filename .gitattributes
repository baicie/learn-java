# Force LF for all source files so cross-platform checkouts stay clean.
# Generated artefacts (route tree, dist, etc.) must also stay LF.

*                 text=auto eol=lf
*.md              text eol=lf
*.yml text        eol=lf
*.yaml text       eol=lf
*.json text       eol=lf
*.gradle text     eol=lf
*.kts text        eol=lf
*.java text       eol=lf
*.ts text         eol=lf
*.tsx text        eol=lf
*.js text         eol=lf
*.cjs text        eol=lf
*.mjs text        eol=lf
*.css text        eol=lf
*.html text       eol=lf
*.sh text         eol=lf
*.properties text eol=lf

# Generated artefacts (do not diff on EOL)
*.gen.ts          text eol=lf
*.generated.ts    text eol=lf

# Shell scripts in deploy/scripts (avoid CRLF on Windows runners)
deploy/**/*.sh    text eol=lf
